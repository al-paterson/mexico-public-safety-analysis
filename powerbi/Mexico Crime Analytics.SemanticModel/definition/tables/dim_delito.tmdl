		annotation SummarizationSetBy = Automatic

	/// Tipo corto con espacios finos (U+200A) al final para que todas las etiquetas midan lo mismo en Segoe UI;
	/// asi el eje, que alinea a la derecha, queda alineado a la izquierda. Generado con pad_labels.py.
	column 'Tipo eje' =
			VAR n =
				SWITCH(
				dim_delito[Tipo corto],
				"Robo", 70,
				"Rapto", 68,
				"Aborto", 65,
				"Fraude", 65,
				"Incesto", 64,
				"Despojo", 60,
				"Lesiones", 60,
				"Falsedad", 59,
				"Extorsión", 57,
				"Secuestro", 55,
				"Amenazas", 54,
				"Homicidio", 54,
				"Electorales", 52,
				"Feminicidio", 50,
				"Falsificación", 48,
				"Acoso sexual", 45,
				"Abuso sexual", 44,
				"Otros libertad", 42,
				"Otros sociedad", 37,
				"Narcomenudeo", 36,
				"Violación simple", 33,
				"Violencia familiar", 31,
				"Otros patrimonio", 30,
				"Evasión de presos", 28,
				"Trata de personas", 28,
				"Pensión alimenticia", 23,
				"Servidores públicos", 23,
				"Tráfico de menores", 23,
				"Abuso de confianza", 22,
				"Otros contra la vida", 22,
				"Violencia de género", 21,
				"Daño a la propiedad", 19,
				"Otros (fuero común)", 19,
				"Violación equiparada", 17,
				"Hostigamiento sexual", 15,
				"Otros delitos sexuales", 15,
				"Otros contra la familia", 14,
				"Corrupción de menores", 8,
				"Allanamiento de morada", 5,
				0
				)
			RETURN dim_delito[Tipo corto] & REPT(UNICHAR(8202), n)
		dataType: string
		lineageTag: fa8df9e7-b1fd-42d3-af0a-939bfc29cf5f
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	/// Nombre corto del tipo historico para etiquetas; los largos se abrevian.
	column 'Tipo corto' =
			SWITCH(
			    dim_delito[Tipo historico],
			    "Incumplimiento de obligaciones de asistencia familiar", "Pensión alimenticia",
			    "Otros delitos que atentan contra la libertad personal", "Otros libertad",
			    "Delitos cometidos por servidores públicos", "Servidores públicos",
			    "Otros delitos contra el patrimonio", "Otros patrimonio",
			    "Otros delitos contra la familia", "Otros contra la familia",
			    "Otros delitos del Fuero Común", "Otros (fuero común)",
			    "Violencia de género en todas sus modalidades distinta a la violencia familiar", "Violencia de género",
			    "Otros delitos que atentan contra la libertad y la seguridad sexual", "Otros delitos sexuales",
			    "Otros delitos que atentan contra la vida y la integridad corporal", "Otros contra la vida",
			    "Otros delitos contra la sociedad", "Otros sociedad",
			    dim_delito[Tipo historico]
			)
		dataType: string
		lineageTag: a7840fd6-539f-477f-a975-81e8a68a569f

